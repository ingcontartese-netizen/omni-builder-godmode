{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:module:knowledge-research-dossier:records:1",
  "title": "KNOWLEDGE_RESEARCH_DOSSIER records",
  "oneOf": [
    {
      "$ref": "#/$defs/material_study"
    },
    {
      "$ref": "#/$defs/light_map"
    },
    {
      "$ref": "#/$defs/deep_research"
    },
    {
      "$ref": "#/$defs/source_manifest"
    },
    {
      "$ref": "#/$defs/outcome"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 3,
      "anyOf": [
        {
          "pattern": "^[A-Za-z]:[\\\\/].+"
        },
        {
          "pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"
        },
        {
          "pattern": "^/.*"
        }
      ]
    },
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "record_base": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "module_id",
        "run_id",
        "topic",
        "topic_sha256",
        "activation_sha256",
        "created_at",
        "record_digest"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "module_id": {
          "const": "KNOWLEDGE_RESEARCH_DOSSIER"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "topic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "activation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "named_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "binding"
      ],
      "properties": {
        "material_id": {
          "$ref": "#/$defs/identifier"
        },
        "binding": {
          "$ref": "#/$defs/file_binding"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "statement",
        "source_ids",
        "confidence",
        "freshness"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "freshness": {
          "enum": [
            "CURRENT_PRIMARY",
            "CURRENT_SECONDARY",
            "HISTORICAL",
            "UNKNOWN"
          ]
        }
      }
    },
    "query_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "query",
        "capture_binding"
      ],
      "properties": {
        "query_id": {
          "$ref": "#/$defs/identifier"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "capture_binding": {
          "$ref": "#/$defs/file_binding"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "research_phase",
        "locator",
        "title",
        "publisher",
        "accessed_at",
        "capture_mode",
        "capture_binding",
        "sections_consulted"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "research_phase": {
          "enum": [
            "LIGHT_WEB",
            "DEEP_WEB"
          ]
        },
        "locator": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "capture_mode": {
          "const": "CAPTURE_MD_ONLY"
        },
        "capture_binding": {
          "$ref": "#/$defs/file_binding"
        },
        "sections_consulted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "source_ids",
        "statement",
        "status",
        "analysis"
      ],
      "properties": {
        "conflict_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED_NONBLOCKING",
            "BLOCKING"
          ]
        },
        "analysis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_id",
        "source_id",
        "origin_locator",
        "media_type",
        "retrieved_at",
        "content_binding",
        "rights_status",
        "rights_evidence_binding",
        "scan_status",
        "scan_receipt_binding",
        "handling_policy"
      ],
      "properties": {
        "acquisition_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "origin_locator": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_binding": {
          "$ref": "#/$defs/file_binding"
        },
        "rights_status": {
          "enum": [
            "AUTHORIZED",
            "OWNED",
            "LICENSED",
            "PUBLIC"
          ]
        },
        "rights_evidence_binding": {
          "$ref": "#/$defs/file_binding"
        },
        "scan_status": {
          "const": "PASS"
        },
        "scan_receipt_binding": {
          "$ref": "#/$defs/file_binding"
        },
        "handling_policy": {
          "const": "QUARANTINE_HASH_NEVER_EXECUTE"
        }
      }
    },
    "provenance_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "sources_actually_read",
        "version_hash_access_date",
        "sections_consulted",
        "received_material_not_used",
        "facts_extracted",
        "model_synthesis_or_inference",
        "conflicts_gaps_and_limits"
      ],
      "properties": {
        "provenance_id": {
          "$ref": "#/$defs/identifier"
        },
        "sources_actually_read": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "version_hash_access_date": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sections_consulted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "received_material_not_used": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "facts_extracted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_synthesis_or_inference": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicts_gaps_and_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "material_study": {
      "allOf": [
        {
          "$ref": "#/$defs/record_base"
        },
        {
          "type": "object",
          "required": [
            "named_materials",
            "study_summary",
            "findings",
            "received_not_used"
          ],
          "properties": {
            "schema": {
              "const": "omni-module-material-study-v1"
            },
            "status": {
              "const": "MATERIAL_STUDY_COMPLETE"
            },
            "named_materials": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/named_material"
              }
            },
            "study_summary": {
              "type": "string",
              "minLength": 1
            },
            "findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "received_not_used": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "light_map": {
      "allOf": [
        {
          "$ref": "#/$defs/record_base"
        },
        {
          "type": "object",
          "required": [
            "material_study_binding",
            "queries",
            "sources",
            "findings"
          ],
          "properties": {
            "schema": {
              "const": "omni-module-light-map-v1"
            },
            "status": {
              "const": "LIGHT_MAP_COMPLETE"
            },
            "material_study_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/query_event"
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/source"
                  },
                  {
                    "properties": {
                      "research_phase": {
                        "const": "LIGHT_WEB"
                      }
                    }
                  }
                ]
              }
            },
            "findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "deep_research": {
      "allOf": [
        {
          "$ref": "#/$defs/record_base"
        },
        {
          "type": "object",
          "required": [
            "material_study_binding",
            "light_map_binding",
            "research_questions",
            "priorities",
            "stop_conditions",
            "queries",
            "sources",
            "findings",
            "conflicts",
            "download_outcome",
            "download_authority_binding",
            "acquisitions"
          ],
          "properties": {
            "schema": {
              "const": "omni-module-deep-research-receipt-v1"
            },
            "status": {
              "const": "DEEP_RESEARCH_COMPLETE"
            },
            "material_study_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "light_map_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "research_questions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "priorities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "stop_conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/query_event"
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/source"
                  },
                  {
                    "properties": {
                      "research_phase": {
                        "const": "DEEP_WEB"
                      }
                    }
                  }
                ]
              }
            },
            "findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "conflicts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/conflict"
              }
            },
            "download_outcome": {
              "enum": [
                "DOWNLOAD_NOT_AUTHORIZED_CAPTURE_MD_ONLY",
                "DOWNLOAD_AUTHORIZED_QUARANTINED_RAW"
              ]
            },
            "download_authority_binding": {
              "oneOf": [
                {
                  "$ref": "#/$defs/file_binding"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acquisitions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/acquisition"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "download_outcome": {
                    "const": "DOWNLOAD_NOT_AUTHORIZED_CAPTURE_MD_ONLY"
                  }
                },
                "required": [
                  "download_outcome"
                ]
              },
              "then": {
                "properties": {
                  "download_authority_binding": {
                    "type": "null"
                  },
                  "acquisitions": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "download_authority_binding": {
                    "$ref": "#/$defs/file_binding"
                  },
                  "acquisitions": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "source_manifest": {
      "allOf": [
        {
          "$ref": "#/$defs/record_base"
        },
        {
          "type": "object",
          "required": [
            "material_study_binding",
            "light_map_binding",
            "deep_research_receipt_binding",
            "material_source_ids",
            "light_source_ids",
            "deep_source_ids",
            "deep_new_source_ids",
            "sources",
            "findings",
            "conflicts",
            "provenance",
            "received_not_used",
            "download_mode",
            "download_authority_binding",
            "acquisitions",
            "limits"
          ],
          "properties": {
            "schema": {
              "const": "omni-module-source-manifest-v1"
            },
            "status": {
              "const": "SOURCE_MANIFEST_FROZEN"
            },
            "material_study_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "light_map_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "deep_research_receipt_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "material_source_ids": {
              "$ref": "#/$defs/nonempty_identifiers"
            },
            "light_source_ids": {
              "$ref": "#/$defs/nonempty_identifiers"
            },
            "deep_source_ids": {
              "$ref": "#/$defs/nonempty_identifiers"
            },
            "deep_new_source_ids": {
              "$ref": "#/$defs/nonempty_identifiers"
            },
            "sources": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/source"
              }
            },
            "findings": {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "conflicts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/conflict"
              }
            },
            "provenance": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/provenance_item"
              }
            },
            "received_not_used": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "download_mode": {
              "enum": [
                "CAPTURE_MD_ONLY",
                "QUARANTINED_RAW"
              ]
            },
            "download_authority_binding": {
              "oneOf": [
                {
                  "$ref": "#/$defs/file_binding"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acquisitions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/acquisition"
              }
            },
            "limits": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "download_mode": {
                    "const": "CAPTURE_MD_ONLY"
                  }
                },
                "required": [
                  "download_mode"
                ]
              },
              "then": {
                "properties": {
                  "download_authority_binding": {
                    "type": "null"
                  },
                  "acquisitions": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "download_authority_binding": {
                    "$ref": "#/$defs/file_binding"
                  },
                  "acquisitions": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "outcome": {
      "allOf": [
        {
          "$ref": "#/$defs/record_base"
        },
        {
          "type": "object",
          "required": [
            "material_study_binding",
            "light_map_binding",
            "deep_research_receipt_binding",
            "source_manifest_binding",
            "dossier_binding",
            "download_outcome",
            "next_gate"
          ],
          "properties": {
            "schema": {
              "const": "omni-knowledge-research-dossier-outcome-v1"
            },
            "status": {
              "const": "KNOWLEDGE_RESEARCH_DOSSIER_READY"
            },
            "material_study_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "light_map_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "deep_research_receipt_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "source_manifest_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "dossier_binding": {
              "$ref": "#/$defs/file_binding"
            },
            "download_outcome": {
              "enum": [
                "DOWNLOAD_NOT_AUTHORIZED_CAPTURE_MD_ONLY",
                "DOWNLOAD_AUTHORIZED_QUARANTINED_RAW"
              ]
            },
            "next_gate": {
              "const": "STOP"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "nonempty_identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
