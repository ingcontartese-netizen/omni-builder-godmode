{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:autonomy-authority:1",
  "title": "Omni-Builder L5 Bounded Autonomy Authority",
  "description": "Explicit autonomy authority for the exact countersigned program and objective. It does not arm automation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "decision", "authority_id", "task_id", "program_id",
    "knowledge_pipeline_id", "operating_binding", "fused_program_binding",
    "program_countersign_binding", "objective_binding", "session_pair_sha256",
    "subject_role", "subject_session_id", "authority_generation", "scope",
    "authorized_actions", "authorized_action_ids", "authorized_operations", "authorized_target_paths",
    "authorized_output_paths", "budgets", "activation_nonce", "one_activation",
    "automation_authorized", "non_grants", "created_at",
    "pm_authority_record_binding", "record_digest"
  ],
  "properties": {
    "schema": {"const": "omni-autonomy-authority-v1"},
    "status": {"const": "AUTONOMY_AUTHORIZED"},
    "decision": {"const": "AUTHORIZED"},
    "authority_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "program_id": {"$ref": "#/$defs/identifier"},
    "knowledge_pipeline_id": {"$ref": "#/$defs/identifier"},
    "operating_binding": {"$ref": "#/$defs/file_binding"},
    "fused_program_binding": {"$ref": "#/$defs/file_binding"},
    "program_countersign_binding": {"$ref": "#/$defs/file_binding"},
    "objective_binding": {"$ref": "#/$defs/file_binding"},
    "session_pair_sha256": {"$ref": "#/$defs/sha256"},
    "subject_role": {"const": "BUILDER"},
    "subject_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority_generation": {"type": "integer", "minimum": 1},
    "scope": {"const": ["F3_BUILD", "F4_TEST"]},
    "authorized_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["F3_BUILD", "F4_TEST", "PROJECT_WRITE", "TEST_EXECUTION", "OFFICIAL_CHANNEL_WRITE", "STATE_CHECKPOINT", "HANDOFF_FREEZE"]}},
    "authorized_action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "authorized_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/authorized_operation"}},
    "authorized_target_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "authorized_output_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "budgets": {"$ref": "#/$defs/budgets"},
    "activation_nonce": {"$ref": "#/$defs/identifier"},
    "one_activation": {"const": true},
    "automation_authorized": {"const": false},
    "non_grants": {"const": ["ARM_AUTOMATION", "SENTINEL_AUTHORITY", "F5_DELIVERY", "INSTALL", "PUBLISH", "EXTERNAL_EFFECTS"]},
    "created_at": {"type": "string", "format": "date-time"},
    "pm_authority_record_binding": {"$ref": "#/$defs/file_binding"},
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
    "absolute_path": {"type": "string", "minLength": 3, "anyOf": [{"pattern": "^[A-Za-z]:[\\\\/].+"}, {"pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"}, {"pattern": "^/.*"}]},
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/absolute_path"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "authorized_operation": {"type": "object", "additionalProperties": false, "required": ["effect", "action_id", "target_path", "output_path", "idempotency_key", "one_shot"], "properties": {"effect": {"enum": ["F3_BUILD", "F4_TEST", "PROJECT_WRITE", "TEST_EXECUTION", "OFFICIAL_CHANNEL_WRITE", "STATE_CHECKPOINT", "HANDOFF_FREEZE"]}, "action_id": {"$ref": "#/$defs/identifier"}, "target_path": {"$ref": "#/$defs/absolute_path"}, "output_path": {"$ref": "#/$defs/absolute_path"}, "idempotency_key": {"$ref": "#/$defs/identifier"}, "one_shot": {"const": true}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["max_turns", "max_tool_calls", "max_writes", "max_elapsed_seconds"], "properties": {"max_turns": {"type": "integer", "minimum": 1}, "max_tool_calls": {"type": "integer", "minimum": 1}, "max_writes": {"type": "integer", "minimum": 1}, "max_elapsed_seconds": {"type": "integer", "minimum": 1}}}
  }
}
