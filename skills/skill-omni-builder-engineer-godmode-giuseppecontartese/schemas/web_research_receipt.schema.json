{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:web-research-receipt:1",
  "title": "Omni-Builder deep web research execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "receipt_id", "pipeline_id", "task_id",
    "session_pair_sha256", "role", "session_id", "lane_root",
    "research_phase", "light_map_binding", "deep_plan_binding",
    "effect_authority_binding", "network_research_performed",
    "cross_read_performed", "query_events", "sources", "light_source_ids",
    "deep_source_ids", "deep_new_source_ids", "download_performed",
    "download_authority_binding", "acquisitions", "created_at", "record_digest"
  ],
  "properties": {
    "schema": {"const": "omni-web-research-receipt-v1"},
    "status": {"const": "DEEP_WEB_RESEARCH_PASS"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "pipeline_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "session_pair_sha256": {"$ref": "#/$defs/sha256"},
    "role": {"enum": ["BUILDER", "VERIFIER"]},
    "session_id": {"type": "string", "minLength": 1},
    "lane_root": {"$ref": "#/$defs/absolute_path"},
    "research_phase": {"const": "DEEP_WEB"},
    "light_map_binding": {"$ref": "#/$defs/file_binding"},
    "deep_plan_binding": {"$ref": "#/$defs/file_binding"},
    "effect_authority_binding": {"$ref": "#/$defs/file_binding"},
    "network_research_performed": {"const": true},
    "cross_read_performed": {"const": false},
    "query_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query_event"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "light_source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
    "deep_source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
    "deep_new_source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
    "download_performed": {"type": "boolean"},
    "download_authority_binding": {
      "oneOf": [{"$ref": "#/$defs/file_binding"}, {"type": "null"}]
    },
    "acquisitions": {"type": "array", "items": {"$ref": "#/$defs/acquisition"}},
    "created_at": {"type": "string", "format": "date-time"},
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"download_performed": {"const": false}}, "required": ["download_performed"]},
      "then": {
        "properties": {
          "download_authority_binding": {"type": "null"},
          "acquisitions": {"maxItems": 0},
          "sources": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/source"},
                {"properties": {"capture_mode": {"const": "CAPTURE_MD_ONLY"}, "research_phase": {"const": "DEEP_WEB"}}}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "download_authority_binding": {"$ref": "#/$defs/file_binding"},
          "acquisitions": {"minItems": 1},
          "sources": {
            "contains": {
              "properties": {
                "research_phase": {"const": "DOWNLOADED_PRIMARY"},
                "capture_mode": {"const": "QUARANTINED_RAW"}
              },
              "required": ["research_phase", "capture_mode"]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
    "nonempty_identifiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
    "absolute_path": {
      "type": "string", "minLength": 3,
      "anyOf": [
        {"pattern": "^[A-Za-z]:[\\\\/].+"},
        {"pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"},
        {"pattern": "^/.*"}
      ]
    },
    "file_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "query_event": {
      "type": "object", "additionalProperties": false,
      "required": ["query_id", "query_text", "executed_at", "tool", "result_capture_binding", "returned_source_ids"],
      "properties": {
        "query_id": {"$ref": "#/$defs/identifier"},
        "query_text": {"type": "string", "minLength": 1},
        "executed_at": {"type": "string", "format": "date-time"},
        "tool": {"type": "string", "minLength": 1},
        "result_capture_binding": {"$ref": "#/$defs/file_binding"},
        "returned_source_ids": {"$ref": "#/$defs/nonempty_identifiers"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "research_phase", "locator", "title", "publisher", "accessed_at", "capture_mode", "capture_binding", "sections_consulted"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "research_phase": {"enum": ["DEEP_WEB", "DOWNLOADED_PRIMARY"]},
        "locator": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "format": "date-time"},
        "capture_mode": {"enum": ["CAPTURE_MD_ONLY", "QUARANTINED_RAW"]},
        "capture_binding": {"$ref": "#/$defs/file_binding"},
        "sections_consulted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "acquisition_id", "source_id", "origin_locator", "media_type",
        "retrieved_at", "content_binding", "rights_status",
        "rights_evidence_binding", "scan_status", "scan_receipt_binding",
        "handling_policy"
      ],
      "properties": {
        "acquisition_id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "origin_locator": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_binding": {"$ref": "#/$defs/file_binding"},
        "rights_status": {"enum": ["AUTHORIZED", "OWNED", "LICENSED", "PUBLIC"]},
        "rights_evidence_binding": {"$ref": "#/$defs/file_binding"},
        "scan_status": {"const": "PASS"},
        "scan_receipt_binding": {"$ref": "#/$defs/file_binding"},
        "handling_policy": {"const": "QUARANTINE_HASH_NEVER_EXECUTE"}
      }
    }
  }
}
