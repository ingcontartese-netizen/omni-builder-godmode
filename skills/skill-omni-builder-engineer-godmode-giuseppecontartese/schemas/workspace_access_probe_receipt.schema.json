{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:workspace-access-probe-receipt:1",
  "title": "Omni-Builder retained create-once workspace access probe receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "receipt_id",
    "envelope_id",
    "activation_receipt_sha256",
    "task_id",
    "task_root",
    "project_root",
    "source_roots",
    "owned_lane_root",
    "session_pair_sha256",
    "capabilities",
    "probe_path",
    "probe_bytes",
    "probe_sha256",
    "create_once",
    "overwritten",
    "retained",
    "read_proofs",
    "record_digest"
  ],
  "properties": {
    "schema": {"const": "omni-workspace-access-probe-receipt-v1"},
    "status": {"const": "CREATE_ONCE_PROBE_RETAINED"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "envelope_id": {"$ref": "#/$defs/identifier"},
    "activation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "task_root": {"$ref": "#/$defs/absolute_path"},
    "project_root": {"$ref": "#/$defs/absolute_path"},
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/absolute_path"}
    },
    "owned_lane_root": {"$ref": "#/$defs/absolute_path"},
    "session_pair_sha256": {"$ref": "#/$defs/sha256"},
    "capabilities": {"const": ["READ_NAMED_SOURCES", "CREATE_DIRECTORIES_IN_PROJECT_ROOT", "CREATE_FILES_IN_PROJECT_ROOT", "WRITE_OWNED_LANE_FILES"]},
    "probe_path": {"$ref": "#/$defs/absolute_path"},
    "probe_bytes": {"type": "integer", "minimum": 1},
    "probe_sha256": {"$ref": "#/$defs/sha256"},
    "create_once": {"const": true},
    "overwritten": {"const": false},
    "retained": {"const": true},
    "read_proofs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_binding"}
    },
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
    "absolute_path": {
      "type": "string",
      "minLength": 3,
      "description": "Native absolute path; runtime rejects ambiguous Win32 aliases and all CWD-relative forms.",
      "anyOf": [
        {"pattern": "^[A-Za-z]:[\\\\/].+"},
        {"pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"},
        {"pattern": "^/.*"}
      ]
    },
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
