{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:knowledge-fusion:1",
  "title": "Omni-Builder Knowledge Fusion",
  "description": "Create-once builder candidate and distinct-verifier countersign over two frozen lane manifests, the decision register, canonical knowledge bytes, complete finding coverage, and preserved dissent. KNOWLEDGE_FUSION_PASS opens only the later planning gate; it grants no plan or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "status",
    "fusion_id",
    "pipeline_id",
    "task_id",
    "session_pair_sha256",
    "author_role",
    "author_session_id",
    "builder_manifest_binding",
    "verifier_manifest_binding",
    "decision_register_binding",
    "canonical_knowledge_binding",
    "finding_ids",
    "dissent_ids_preserved",
    "countersigner_role",
    "countersigner_session_id",
    "candidate_binding",
    "created_at",
    "record_digest"
  ],
  "properties": {
    "schema": {
      "const": "omni-knowledge-fusion-v1"
    },
    "kind": {
      "enum": [
        "FUSION_CANDIDATE",
        "FUSION_COUNTERSIGN"
      ]
    },
    "status": {
      "enum": [
        "FUSION_EMITTED",
        "KNOWLEDGE_FUSION_PASS"
      ]
    },
    "fusion_id": {
      "$ref": "#/$defs/identifier"
    },
    "pipeline_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "session_pair_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "author_role": {
      "const": "BUILDER"
    },
    "author_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "builder_manifest_binding": {
      "$ref": "#/$defs/file_binding"
    },
    "verifier_manifest_binding": {
      "$ref": "#/$defs/file_binding"
    },
    "decision_register_binding": {
      "$ref": "#/$defs/file_binding"
    },
    "canonical_knowledge_binding": {
      "$ref": "#/$defs/file_binding"
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dissent_ids_preserved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "countersigner_role": {
      "oneOf": [
        {
          "const": "VERIFIER"
        },
        {
          "type": "null"
        }
      ]
    },
    "countersigner_session_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_binding": {
      "$ref": "#/$defs/nullable_file_binding"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "FUSION_CANDIDATE"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "FUSION_EMITTED"
          },
          "countersigner_role": {
            "type": "null"
          },
          "countersigner_session_id": {
            "type": "null"
          },
          "candidate_binding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "FUSION_COUNTERSIGN"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "KNOWLEDGE_FUSION_PASS"
          },
          "countersigner_role": {
            "const": "VERIFIER"
          },
          "countersigner_session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "candidate_binding": {
            "$ref": "#/$defs/file_binding"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 3,
      "anyOf": [
        {
          "pattern": "^[A-Za-z]:[\\\\/].+"
        },
        {
          "pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"
        },
        {
          "pattern": "^/.*"
        }
      ]
    },
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullable_file_binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/file_binding"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
