{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:source-manifest:1",
  "title": "Omni-Builder cumulative lane source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "manifest_id", "pipeline_id", "task_id",
    "session_pair_sha256", "role", "session_id", "lane_root",
    "material_join_binding", "light_map_binding", "deep_plan_binding",
    "deep_research_receipt_binding", "material_source_ids", "light_source_ids",
    "deep_source_ids", "deep_new_source_ids", "sources", "findings",
    "conflicts", "dissent", "provenance", "received_not_used",
    "download_mode", "download_authority_binding", "acquisitions",
    "download_fallback", "limits", "cross_read_performed", "created_at",
    "record_digest"
  ],
  "properties": {
    "schema": {"const": "omni-source-manifest-v1"},
    "status": {"const": "SOURCE_MANIFEST_FROZEN"},
    "manifest_id": {"$ref": "#/$defs/identifier"},
    "pipeline_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "session_pair_sha256": {"$ref": "#/$defs/sha256"},
    "role": {"enum": ["BUILDER", "VERIFIER"]},
    "session_id": {"type": "string", "minLength": 1},
    "lane_root": {"$ref": "#/$defs/absolute_path"},
    "material_join_binding": {"$ref": "#/$defs/file_binding"},
    "light_map_binding": {"$ref": "#/$defs/file_binding"},
    "deep_plan_binding": {"$ref": "#/$defs/file_binding"},
    "deep_research_receipt_binding": {"$ref": "#/$defs/file_binding"},
    "material_source_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
    "light_source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
    "deep_source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
    "deep_new_source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
    "sources": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/source"}},
    "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "dissent": {"type": "array", "items": {"$ref": "#/$defs/dissent_item"}},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance_item"}},
    "received_not_used": {"type": "array", "items": {"$ref": "#/$defs/received_not_used_item"}},
    "download_mode": {"enum": ["CAPTURE_MD_ONLY", "QUARANTINED_RAW"]},
    "download_authority_binding": {"oneOf": [{"$ref": "#/$defs/file_binding"}, {"type": "null"}]},
    "acquisitions": {"type": "array", "items": {"$ref": "#/$defs/acquisition"}},
    "download_fallback": {"enum": ["CAPTURE_MD_ONLY", "NOT_APPLICABLE"]},
    "limits": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "cross_read_performed": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"download_mode": {"const": "CAPTURE_MD_ONLY"}}, "required": ["download_mode"]},
      "then": {
        "properties": {
          "download_authority_binding": {"type": "null"},
          "acquisitions": {"maxItems": 0},
          "download_fallback": {"const": "CAPTURE_MD_ONLY"}
        }
      },
      "else": {
        "properties": {
          "download_authority_binding": {"$ref": "#/$defs/file_binding"},
          "acquisitions": {"minItems": 1},
          "download_fallback": {"const": "NOT_APPLICABLE"},
          "sources": {
            "contains": {
              "properties": {
                "research_phase": {"const": "DOWNLOADED_PRIMARY"},
                "capture_mode": {"const": "QUARANTINED_RAW"}
              },
              "required": ["research_phase", "capture_mode"]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
    "nonempty_identifiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
    "absolute_path": {
      "type": "string", "minLength": 3,
      "anyOf": [
        {"pattern": "^[A-Za-z]:[\\\\/].+"},
        {"pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"},
        {"pattern": "^/.*"}
      ]
    },
    "file_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "research_phase", "locator", "title", "publisher", "accessed_at", "capture_mode", "capture_binding", "sections_consulted"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "research_phase": {"enum": ["USER_MATERIAL", "LIGHT_WEB", "DEEP_WEB", "DOWNLOADED_PRIMARY"]},
        "locator": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "format": "date-time"},
        "capture_mode": {"enum": ["CAPTURE_MD_ONLY", "QUARANTINED_RAW", "USER_PROVIDED"]},
        "capture_binding": {"$ref": "#/$defs/file_binding"},
        "sections_consulted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "statement", "source_ids", "confidence", "freshness"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "freshness": {"enum": ["CURRENT_PRIMARY", "CURRENT_SECONDARY", "HISTORICAL", "UNKNOWN"]}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflict_id", "source_ids", "statement", "status", "analysis"],
      "properties": {
        "conflict_id": {"$ref": "#/$defs/identifier"},
        "source_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["RESOLVED", "UNRESOLVED_NONBLOCKING", "BLOCKING"]},
        "analysis": {"type": "string", "minLength": 1}
      }
    },
    "dissent_item": {
      "type": "object", "additionalProperties": false,
      "required": ["dissent_id", "statement", "source_ids", "status", "rationale"],
      "properties": {
        "dissent_id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/nonempty_identifiers"},
        "status": {"enum": ["OPEN", "PRESERVED_NONBLOCKING", "ESCALATED_BLOCKING"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "provenance_item": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_id", "sources_actually_read", "version_hash_access_date", "sections_consulted", "received_material_not_used", "facts_extracted", "model_synthesis_or_inference", "conflicts_gaps_and_limits"],
      "properties": {
        "provenance_id": {"$ref": "#/$defs/identifier"},
        "sources_actually_read": {"$ref": "#/$defs/nonempty_identifiers"},
        "version_hash_access_date": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sections_consulted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "received_material_not_used": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "facts_extracted": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "model_synthesis_or_inference": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conflicts_gaps_and_limits": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "received_not_used_item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "reason_code", "rationale"],
      "properties": {
        "item_id": {"$ref": "#/$defs/identifier"},
        "reason_code": {"$ref": "#/$defs/identifier"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": ["acquisition_id", "source_id", "origin_locator", "media_type", "retrieved_at", "content_binding", "rights_status", "rights_evidence_binding", "scan_status", "scan_receipt_binding", "handling_policy"],
      "properties": {
        "acquisition_id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "origin_locator": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_binding": {"$ref": "#/$defs/file_binding"},
        "rights_status": {"enum": ["AUTHORIZED", "OWNED", "LICENSED", "PUBLIC"]},
        "rights_evidence_binding": {"$ref": "#/$defs/file_binding"},
        "scan_status": {"const": "PASS"},
        "scan_receipt_binding": {"$ref": "#/$defs/file_binding"},
        "handling_policy": {"const": "QUARANTINE_HASH_NEVER_EXECUTE"}
      }
    }
  }
}
