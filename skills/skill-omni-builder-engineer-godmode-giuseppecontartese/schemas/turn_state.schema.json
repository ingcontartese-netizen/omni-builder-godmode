{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:turn-state:1",
  "title": "Governed turn state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "turn_id", "phase", "status", "producer",
    "objective_sha256", "preconditions", "evidence", "failures", "reason",
    "previous_record_sha256", "created_at", "record_digest"
  ],
  "properties": {
    "schema": {"const": "omni-turn-state-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["CANONIZE", "PLAN", "F3_BUILD", "F4_TEST", "GATE"]},
    "status": {"enum": ["PENDING", "RUNNING", "PASS", "FAIL", "INCONCLUSIVE", "BLOCKED_PENDING_HUMAN", "BLOCKED_PENDING_INFRA"]},
    "producer": {"type": "string", "minLength": 1},
    "objective_sha256": {"$ref": "#/$defs/sha256"},
    "preconditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reason": {"type": "string", "minLength": 1},
    "previous_record_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "created_at": {"type": "string", "format": "date-time"},
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
