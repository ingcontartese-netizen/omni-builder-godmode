{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:execution-lease:1",
  "title": "Omni-Builder L5 Create-Once Fenced Execution Lease",
  "description": "A prepared create-once lease. It authorizes effects only when an ACTIVE operating state binds the exact bytes and every predecessor control source is fenced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "lease_id", "task_id", "program_id", "regime_binding",
    "objective_binding", "autonomy_authority_binding", "arm_authority_binding",
    "sentinel_bundle_binding", "owner_role", "owner_session_id",
    "predecessor_session_id", "predecessor_fencing_receipt_binding",
    "fenced_control_classes", "generation", "fencing_token", "previous_lease_binding",
    "single_writer", "scope", "grants", "authorized_operations", "authorized_target_paths",
    "authorized_output_paths", "trusted_pm_root", "trusted_pm_issuer_id",
    "non_grants", "activation_state_path",
    "created_at", "record_digest"
  ],
  "properties": {
    "schema": {"const": "omni-execution-lease-v1"},
    "status": {"const": "EXECUTION_LEASE_PREPARED"},
    "lease_id": {"$ref": "#/$defs/identifier"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "program_id": {"$ref": "#/$defs/identifier"},
    "regime_binding": {"$ref": "#/$defs/file_binding"},
    "objective_binding": {"$ref": "#/$defs/file_binding"},
    "autonomy_authority_binding": {"$ref": "#/$defs/file_binding"},
    "arm_authority_binding": {"$ref": "#/$defs/file_binding"},
    "sentinel_bundle_binding": {"$ref": "#/$defs/file_binding"},
    "owner_role": {"const": "BUILDER"},
    "owner_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "predecessor_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "predecessor_fencing_receipt_binding": {"$ref": "#/$defs/file_binding"},
    "fenced_control_classes": {"const": ["OBJECTIVE", "HEARTBEAT", "RETRY", "SCHEDULE", "BACKGROUND_JOB", "AUTOMATION", "ARCHIVED_TASK_WAKEUP"]},
    "generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"$ref": "#/$defs/identifier"},
    "previous_lease_binding": {"oneOf": [{"$ref": "#/$defs/file_binding"}, {"type": "null"}]},
    "single_writer": {"const": true},
    "scope": {"const": ["F3_BUILD", "F4_TEST"]},
    "grants": {"const": ["F3_BUILD", "F4_TEST"]},
    "authorized_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/authorized_operation"}},
    "authorized_target_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "authorized_output_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/absolute_path"}},
    "trusted_pm_root": {"$ref": "#/$defs/absolute_path"},
    "trusted_pm_issuer_id": {"$ref": "#/$defs/identifier"},
    "non_grants": {"const": ["SENTINEL_AUTHORITY", "F5_DELIVERY", "INSTALL", "PUBLISH", "EXTERNAL_EFFECTS"]},
    "activation_state_path": {"$ref": "#/$defs/absolute_path"},
    "created_at": {"type": "string", "format": "date-time"},
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
    "absolute_path": {"type": "string", "minLength": 3, "anyOf": [{"pattern": "^[A-Za-z]:[\\\\/].+"}, {"pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"}, {"pattern": "^/.*"}]},
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/absolute_path"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "authorized_operation": {"type": "object", "additionalProperties": false, "required": ["effect", "action_id", "target_path", "output_path", "idempotency_key", "one_shot"], "properties": {"effect": {"enum": ["F3_BUILD", "F4_TEST", "PROJECT_WRITE", "TEST_EXECUTION", "OFFICIAL_CHANNEL_WRITE", "STATE_CHECKPOINT", "HANDOFF_FREEZE"]}, "action_id": {"$ref": "#/$defs/identifier"}, "target_path": {"$ref": "#/$defs/absolute_path"}, "output_path": {"$ref": "#/$defs/absolute_path"}, "idempotency_key": {"$ref": "#/$defs/identifier"}, "one_shot": {"const": true}}}
  }
}
