{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-builder:guided-intake-state:1",
  "title": "Governed guided-intake state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state_id",
    "run_id",
    "generation",
    "phase",
    "status",
    "activation_binding",
    "run_kind",
    "effect_policy",
    "workspace_access_envelope",
    "profile",
    "independence",
    "topology",
    "session_pair",
    "team_card",
    "station_matrix",
    "station_matrix_sha256",
    "question_matrix",
    "intake_proposal",
    "relay",
    "critical_closure",
    "well",
    "knowledge",
    "program",
    "cutover",
    "blocking_reason_codes",
    "previous_record_sha256",
    "created_at",
    "record_digest"
  ],
  "properties": {
    "schema": {
      "const": "omni-guided-intake-state-v1"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "TOPOLOGY_BOUND",
        "TEAM_CARD_PENDING",
        "TEAM_CARD_DUAL_ACK",
        "QUESTIONS_ACTIVE",
        "PROPOSAL_READBACK_PENDING",
        "INTAKE_READY",
        "INTAKE_BLOCKED"
      ]
    },
    "status": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "READY",
        "BLOCKED"
      ]
    },
    "activation_binding": {
      "$ref": "#/$defs/activation_binding"
    },
    "run_kind": {
      "$ref": "#/$defs/run_kind"
    },
    "effect_policy": {
      "$ref": "#/$defs/effect_policy"
    },
    "workspace_access_envelope": {
      "$ref": "#/$defs/workspace_access_envelope_contract"
    },
    "profile": {
      "enum": [
        "GODMODE",
        "PROFILE_DEGRADED"
      ]
    },
    "independence": {
      "enum": [
        "PEER_INDEPENDENT",
        "ADVERSARIAL_SOLO",
        "NOT_QUALIFIED"
      ]
    },
    "topology": {
      "enum": [
        "SOLO_DUAL_HAT",
        "TEAM_DUAL_LANE"
      ]
    },
    "session_pair": {
      "$ref": "#/$defs/session_pair"
    },
    "team_card": {
      "$ref": "#/$defs/team_card"
    },
    "station_matrix": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "station_matrix_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "question_matrix": {
      "$ref": "#/$defs/question_matrix"
    },
    "intake_proposal": {
      "$ref": "#/$defs/intake_proposal"
    },
    "relay": {
      "$ref": "#/$defs/relay"
    },
    "critical_closure": {
      "$ref": "#/$defs/critical_closure"
    },
    "well": {
      "$ref": "#/$defs/well_placeholder"
    },
    "knowledge": {
      "$ref": "#/$defs/knowledge_placeholder"
    },
    "program": {
      "$ref": "#/$defs/program_placeholder"
    },
    "cutover": {
      "$ref": "#/$defs/cutover_placeholder"
    },
    "blocking_reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    },
    "previous_record_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 3,
      "description": "Native absolute path. Runtime additionally rejects relative and drive-relative forms, ADS, device namespaces, reserved-device names, and trailing-dot/space aliases.",
      "anyOf": [
        {"pattern": "^[A-Za-z]:[\\\\/].+"},
        {"pattern": "^(?:\\\\\\\\|//)[^\\\\/]+[\\\\/][^\\\\/]+(?:[\\\\/].*)?$"},
        {"pattern": "^/.*"}
      ]
    },
    "nullable_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_kind": {
      "enum": [
        "REAL",
        "DRY_RUN"
      ]
    },
    "effect_policy": {
      "enum": [
        "DOWNSTREAM_GATED_REAL",
        "SIMULATE_WITHOUT_MATERIALIZATION"
      ]
    },
    "workspace_access_envelope_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "outcome",
        "envelope_id",
        "activation_receipt_sha256",
        "task_id",
        "task_root",
        "project_root",
        "source_roots",
        "owned_lane_root",
        "session_pair_sha256",
        "run_kind",
        "requested_capabilities",
        "granted_capabilities",
        "non_grants",
        "separate_authorizations_required",
        "excluded_paths",
        "probe_receipt_binding",
        "record_digest"
      ],
      "properties": {
        "schema": {
          "const": "omni-workspace-access-envelope-v1"
        },
        "status": {
          "enum": [
            "ACCESS_READY",
            "AUTONOMY_UNAVAILABLE_NO_ACCESS"
          ]
        },
        "outcome": {
          "enum": [
            "ACCESS_GRANTED_NON_DESTRUCTIVE",
            "ACCESS_PARTIAL",
            "ACCESS_DENIED",
            "ACCESS_PLANNED_DRY_RUN"
          ]
        },
        "envelope_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"
        },
        "activation_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"
        },
        "task_root": {"$ref": "#/$defs/absolute_path"},
        "project_root": {"$ref": "#/$defs/absolute_path"},
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/absolute_path"}
        },
        "owned_lane_root": {"$ref": "#/$defs/absolute_path"},
        "session_pair_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_kind": {
          "$ref": "#/$defs/run_kind"
        },
        "requested_capabilities": {
          "const": [
            "READ_NAMED_SOURCES",
            "CREATE_DIRECTORIES_IN_PROJECT_ROOT",
            "CREATE_FILES_IN_PROJECT_ROOT",
            "WRITE_OWNED_LANE_FILES"
          ]
        },
        "granted_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "READ_NAMED_SOURCES",
              "CREATE_DIRECTORIES_IN_PROJECT_ROOT",
              "CREATE_FILES_IN_PROJECT_ROOT",
              "WRITE_OWNED_LANE_FILES"
            ]
          }
        },
        "non_grants": {
          "const": [
            "DELETE",
            "MOVE",
            "RENAME_OUTSIDE_ROOT",
            "OVERWRITE_PREEXISTING_USER_FILE",
            "EXECUTE",
            "INSTALL",
            "PUBLISH",
            "EXTERNAL_EFFECTS"
          ]
        },
        "separate_authorizations_required": {
          "const": [
            "NETWORK_RESEARCH",
            "DOWNLOAD"
          ]
        },
        "excluded_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/absolute_path"}
        },
        "probe_receipt_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/file_binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ACCESS_READY"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "ACCESS_GRANTED_NON_DESTRUCTIVE"
              },
              "run_kind": {
                "const": "REAL"
              },
              "granted_capabilities": {
                "const": [
                  "READ_NAMED_SOURCES",
                  "CREATE_DIRECTORIES_IN_PROJECT_ROOT",
                  "CREATE_FILES_IN_PROJECT_ROOT",
                  "WRITE_OWNED_LANE_FILES"
                ]
              },
              "probe_receipt_binding": {
                "$ref": "#/$defs/file_binding"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_kind": {
                "const": "DRY_RUN"
              }
            },
            "required": [
              "run_kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "AUTONOMY_UNAVAILABLE_NO_ACCESS"
              },
              "outcome": {
                "const": "ACCESS_PLANNED_DRY_RUN"
              },
              "granted_capabilities": {
                "maxItems": 0
              },
              "probe_receipt_binding": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "ACCESS_GRANTED_NON_DESTRUCTIVE"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "ACCESS_READY"
              },
              "run_kind": {
                "const": "REAL"
              },
              "granted_capabilities": {
                "const": [
                  "READ_NAMED_SOURCES",
                  "CREATE_DIRECTORIES_IN_PROJECT_ROOT",
                  "CREATE_FILES_IN_PROJECT_ROOT",
                  "WRITE_OWNED_LANE_FILES"
                ]
              },
              "probe_receipt_binding": {
                "$ref": "#/$defs/file_binding"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "AUTONOMY_UNAVAILABLE_NO_ACCESS"
              },
              "run_kind": {
                "const": "REAL"
              }
            },
            "required": [
              "status",
              "run_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "ACCESS_PARTIAL",
                  "ACCESS_DENIED"
                ]
              },
              "probe_receipt_binding": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "ACCESS_PARTIAL"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "AUTONOMY_UNAVAILABLE_NO_ACCESS"
              },
              "run_kind": {
                "const": "REAL"
              },
              "granted_capabilities": {
                "minItems": 1,
                "maxItems": 3
              },
              "probe_receipt_binding": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "ACCESS_DENIED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "AUTONOMY_UNAVAILABLE_NO_ACCESS"
              },
              "run_kind": {
                "const": "REAL"
              },
              "granted_capabilities": {
                "maxItems": 0
              },
              "probe_receipt_binding": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "properties": {
            "path": {"$ref": "#/$defs/absolute_path"}
          }
        }
      ]
    },
    "proposal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {"$ref": "#/$defs/absolute_path"},
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "activation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "receipt_outcome",
        "decision_schema",
        "decision_status",
        "activation_path",
        "task_scope",
        "run_kind",
        "effect_policy",
        "knowledge_available",
        "skill_invoked",
        "effect_authorized",
        "activation_level",
        "modules_used",
        "authority_grants",
        "artifact_grants",
        "requested_effects",
        "effect_grants",
        "non_grants",
        "access_envelope_identity",
        "activation_grants",
        "activation_non_grants",
        "intake_allowed",
        "mode_selection_allowed",
        "mode_gate",
        "next_gate"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_outcome": {
          "const": "ACCEPTED"
        },
        "decision_schema": {
          "const": "omni-invocation-decision-v2"
        },
        "decision_status": {
          "const": "ACTIVATION_ALLOWED"
        },
        "activation_path": {
          "enum": [
            "EXPLICIT_USER_OPT_IN",
            "PROPOSAL_ACCEPTED"
          ]
        },
        "task_scope": {
          "const": "CURRENT_TASK_ONLY"
        },
        "run_kind": {
          "$ref": "#/$defs/run_kind"
        },
        "effect_policy": {
          "$ref": "#/$defs/effect_policy"
        },
        "knowledge_available": {
          "const": true
        },
        "skill_invoked": {
          "const": true
        },
        "effect_authorized": {
          "const": false
        },
        "activation_level": {
          "const": "OMNI_FULL"
        },
        "modules_used": {
          "const": []
        },
        "authority_grants": {
          "const": [
            "METHOD_USE",
            "FULL_ORCHESTRATION"
          ]
        },
        "artifact_grants": {
          "const": []
        },
        "requested_effects": {
          "const": []
        },
        "effect_grants": {
          "const": []
        },
        "non_grants": {
          "const": [
            "DELETE",
            "MOVE",
            "RENAME_OUTSIDE_ROOT",
            "OVERWRITE_PREEXISTING_USER_FILE",
            "EXECUTE",
            "INSTALL",
            "PUBLISH",
            "EXTERNAL_EFFECTS",
            "CREATE_FILES",
            "ARM_AUTOMATION"
          ]
        },
        "access_envelope_identity": {
          "const": "PENDING"
        },
        "activation_grants": {
          "const": [
            "METHOD_USE"
          ]
        },
        "activation_non_grants": {
          "const": [
            "PARTNER_SELECTION",
            "WEB_ACCESS",
            "DOWNLOAD",
            "PROJECT_WRITE",
            "EXECUTION",
            "AUTONOMY"
          ]
        },
        "intake_allowed": {
          "const": true
        },
        "mode_selection_allowed": {
          "const": false
        },
        "mode_gate": {
          "const": "MODE_BEFORE_PROGRAM"
        },
        "next_gate": {
          "const": "GUIDED_INTAKE"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identity",
        "host",
        "session_id",
        "mandate_path",
        "mandate_bytes",
        "mandate_sha256",
        "write_lane",
        "owned_paths"
      ],
      "properties": {
        "role": {
          "enum": [
            "BUILDER",
            "VERIFIER"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "mandate_path": {
          "type": "string",
          "minLength": 1
        },
        "mandate_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mandate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "write_lane": {
          "type": "string",
          "minLength": 1
        },
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "properties": {
            "mandate_path": {"$ref": "#/$defs/absolute_path"},
            "write_lane": {"$ref": "#/$defs/absolute_path"},
            "owned_paths": {
              "items": {"$ref": "#/$defs/absolute_path"}
            }
          }
        }
      ]
    },
    "session_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "pair_sha256",
        "lock_status",
        "builder",
        "verifier"
      ],
      "properties": {
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "pair_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lock_status": {
          "const": "LOCKED_UNTIL_CUTOVER"
        },
        "builder": {
          "$ref": "#/$defs/participant"
        },
        "verifier": {
          "$ref": "#/$defs/participant"
        }
      }
    },
    "team_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "session_id",
        "status",
        "observed_card_sha256",
        "relay_id",
        "created_at"
      ],
      "properties": {
        "role": {
          "enum": [
            "BUILDER",
            "VERIFIER"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ACK",
            "MISSING",
            "MISMATCH"
          ]
        },
        "observed_card_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "relay_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^RELAY-[0-9]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "team_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "card_sha256",
        "card_relay_id",
        "status",
        "session_pair_sha256",
        "sovereign_identity",
        "partner_identity",
        "partner_selection_authorization_relay_id",
        "partner_selection_authorization_sha256",
        "turn_order",
        "prohibitions",
        "pm_reserved_gates",
        "transport",
        "acks"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "card_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "card_relay_id": {
          "type": "string",
          "pattern": "^RELAY-[0-9]{3}$"
        },
        "status": {
          "enum": [
            "DRAFT",
            "AWAITING_DUAL_ACK",
            "TEAM_CARD_DUAL_ACK",
            "BLOCKED"
          ]
        },
        "session_pair_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sovereign_identity": {
          "type": "string",
          "minLength": 1
        },
        "partner_identity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "partner_selection_authorization_relay_id": {
          "type": "string",
          "pattern": "^RELAY-[0-9]{3}$"
        },
        "partner_selection_authorization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "turn_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BUILDER",
              "VERIFIER"
            ]
          }
        },
        "prohibitions": {
          "const": [
            "NO_CROSS_WRITE",
            "NO_AUTHOR_AND_SIGN",
            "NO_IMPLICIT_AUTHORITY",
            "NO_F5",
            "NO_INSTALLATION",
            "NO_PUBLICATION",
            "NO_EXTERNAL_EFFECTS"
          ]
        },
        "pm_reserved_gates": {
          "const": [
            "SCOPE_CHANGE",
            "AUTHORITY_EXPANSION",
            "KNOWLEDGE_FUSION",
            "PROGRAM_BAPTISM",
            "OPERATING_REGIME_BINDING",
            "EXTERNAL_EFFECTS",
            "INSTALLATION",
            "PUBLICATION"
          ]
        },
        "transport": {
          "const": "PM_RELAY"
        },
        "acks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "builder",
            "verifier"
          ],
          "properties": {
            "builder": {
              "$ref": "#/$defs/team_ack"
            },
            "verifier": {
              "$ref": "#/$defs/team_ack"
            }
          }
        }
      }
    },
    "classification": {
      "enum": [
        "KNOWN",
        "ASSUMED",
        "UNKNOWN",
        "DECISION_REQUIRED",
        "EVIDENCE_REQUIRED"
      ]
    },
    "station_id": {
      "enum": [
        "Q0_TOPOLOGY",
        "PARTNER_IDENTITY",
        "ROLE_BINDING",
        "FILE_OWNERSHIP",
        "TURN_ORDER",
        "PROHIBITIONS",
